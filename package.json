{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@jackmazac/opencode-conductor",
  "version": "0.1.0",
  "description": "Opinionated multi-agent planning, delegation, review, and documentation workflow plugin for OpenCode.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackmazac/opencode-conductor.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent-orchestration",
    "planning",
    "software-engineering-workflow"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./bridge-contracts": "./packages/bridge-contracts/src/index.ts",
    "./bridge-contracts/events": "./packages/bridge-contracts/src/events.ts",
    "./bridge-contracts/messages": "./packages/bridge-contracts/src/messages.ts",
    "./bridge-contracts/subagent": "./packages/bridge-contracts/src/subagent.ts",
    "./lifecycle-contracts": "./packages/lifecycle-contracts/src/index.ts",
    "./lifecycle-contracts/artifacts": "./packages/lifecycle-contracts/src/artifacts.ts",
    "./lifecycle-contracts/config": "./packages/lifecycle-contracts/src/config.ts",
    "./lifecycle-contracts/decisions": "./packages/lifecycle-contracts/src/decisions.ts",
    "./lifecycle-contracts/external-sources": "./packages/lifecycle-contracts/src/external-sources.ts",
    "./lifecycle-contracts/messages": "./packages/lifecycle-contracts/src/messages.ts",
    "./lifecycle-contracts/object-id": "./packages/lifecycle-contracts/src/object-id.ts",
    "./conformance/lifecycle": "./packages/conformance/lifecycle/index.ts",
    "./spine": "./packages/spine/src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "plugins",
    "packages",
    "!packages/**/*.test.ts",
    "prompts",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "conductor": "./src/cli.ts"
  },
  "dependencies": {
    "@jackmazac/opencode-fleet-contracts": "file:../opencode-fleet-contracts",
    "@jackmazac/opencode-host-adapter": "file:/Users/jack.mazac/Developer/opencode-host-adapter",
    "@opencode-ai/plugin": "1.14.31",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "@tsconfig/bun": "latest",
    "@typescript/native-preview": "latest",
    "opencode-engram": "file:../engram"
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "lint:no-zod": "bun run ./node_modules/@jackmazac/opencode-host-adapter/src/cli/check-no-zod-import.ts src/",
    "check": "bun run lint:no-zod && bun run typecheck && bun test",
    "doctor": "bun src/cli.ts doctor",
    "status": "bun src/cli.ts status",
    "smoke:runtime": "bun scripts/runtime-smoke.ts",
    "smoke:explore-fast": "CURSOR_CLI_INTEGRATION=1 bun test src/explore-fast.test.ts"
  }
}
