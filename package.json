{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-conductor",
  "version": "0.1.0",
  "description": "Opinionated multi-agent planning, delegation, review, and documentation workflow plugin for OpenCode.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackmazac/opencode-conductor.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent-orchestration",
    "planning",
    "software-engineering-workflow"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "prompts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "1.14.31",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "@tsconfig/bun": "latest",
    "@typescript/native-preview": "latest",
    "opencode-engram": "file:../engram"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsgo --noEmit"
  }
}
